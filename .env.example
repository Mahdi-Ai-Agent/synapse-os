# Synapse environment (optional). Copy to .env; .env is gitignored. Never commit real values.
# The server loads this file at start (apps/server/src/env.ts); variables already set in the shell win.

# Vault folder (default: ~/Synapse/vault). Keep it OUTSIDE this repo.
SYNAPSE_VAULT=

# Server port (default: 4317)
SYNAPSE_PORT=

# Bind host. Unset: 127.0.0.1, or 0.0.0.0 once Settings → Phone enables LAN access. Setting it pins the binding
# (0.0.0.0 = every interface; the Settings switch is then stored but has no effect). docs/ARCHITECTURE.md "Access control".
SYNAPSE_HOST=

# Built web UI served at / by the server (default: apps/web/dist, produced by `pnpm build`)
SYNAPSE_WEB_DIST=

# Cloud / container (docs/DEPLOY.md). SYNAPSE_PAIR_TOKEN pins the pairing token (at least 32 chars of A-Z a-z 0-9 _ -);
# CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) signs the Claude Code CLI in headlessly — read by the CLI, never by Synapse.
SYNAPSE_PAIR_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
# false: loopback clients sign in too (the Docker image sets it; behind a proxy on the same host loopback proves nothing)
SYNAPSE_TRUST_LOOPBACK=
# The origin other apps reach this server at, e.g. https://synapse.example.com (MCP and OAuth, docs/ARCHITECTURE.md
# "MCP connector"); empty = the request's own host, https for every domain name.
SYNAPSE_PUBLIC_URL=

# API-key engines (docs/BRAIN-ENGINES.md). A key pasted in Settings → Brain engine takes precedence over these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenAI-compatible base URL for the openai-api engine (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Optional: explicit CLI binaries when they are not on PATH
SYNAPSE_CLAUDE_BIN=
SYNAPSE_CODEX_BIN=
