{
  "name": "synapse",
  "private": true,
  "license": "MIT",
  "version": "0.3.1",
  "description": "Synapse \u2014 AI-native second brain + life OS",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @synapse/server dev\" \"pnpm --filter @synapse/web dev\"",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @synapse/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "vault:create": "tsx scripts/create-vault.ts",
    "vault:seed": "tsx scripts/seed-sample-vault.ts",
    "vault:context": "tsx scripts/estimate-vault-context.ts",
    "vault:validate": "tsx scripts/validate-vault.ts",
    "mac:dmg": "pnpm --filter @synapse/desktop dist",
    "eval:vault": "tsx eval/run-vault-eval.ts"
  },
  "devDependencies": {
    "@synapse/brain": "workspace:*",
    "@synapse/core": "workspace:*",
    "@synapse/vault-template": "workspace:*",
    "@types/node": "^22",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
